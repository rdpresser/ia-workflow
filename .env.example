# =============================================================================
# AI Taskflow — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
#   cp .env.example .env
#
# This file is safe to commit — it contains only placeholders, no real secrets.
# pydantic-settings reads the actual .env file automatically at startup.
# =============================================================================

# --- Application ---
PROJECT_NAME="AI Taskflow"
VERSION="0.1.0"
ENVIRONMENT="development"   # development | staging | production

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_taskflow_db

# --- Redis ---
REDIS_PORT=6379

# --- Security / JWT ---
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Provider Keys ---
# Set the key for the provider you want to use.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
